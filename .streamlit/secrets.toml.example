# Configure these in Streamlit Community Cloud App Settings -> Secrets (or Render/Railway Env Vars)
# NEVER commit a populated .streamlit/secrets.toml file to Git.

KT_DEMO_BOOTSTRAP = "1"
KT_VAULT_DB_PATH = "demo_runtime/data/kt_vault_demo.db"
KT_VAULT_STORAGE_ROOT = "demo_runtime/documents"
KT_VAULT_LOG_DIR = "demo_runtime/logs"
KT_VAULT_ENCRYPTION_MODE = "encrypted_only"
KT_VAULT_SQLITE_WAL = "1"
KT_AUTH_PROVIDER = "local"
KT_SESSION_IDLE_TIMEOUT_MINUTES = "30"
KT_SESSION_MAX_HOURS = "12"
AZAPI_ENABLED = "false"
AZAPI_API_KEY = "REPLACE_WITH_YOUR_AZAPI_KEY"
AZAPI_TIMEOUT_SECONDS = "15"
AZAPI_MAX_RETRIES = "1"

# Generate fresh 64-hex (256-bit) demo-only key: python -c "import secrets; print(secrets.token_hex(32))"
KT_VAULT_STORAGE_KEY = "REPLACE_WITH_FRESH_64_HEX_DEMO_KEY"

# Strong demo-only staff passwords (never reuse real credentials)
KT_DEMO_ADMIN_PASS = "REPLACE_WITH_DEMO_ADMIN_PASSWORD"
KT_DEMO_SALES_PASS = "REPLACE_WITH_DEMO_SALES_PASSWORD"
